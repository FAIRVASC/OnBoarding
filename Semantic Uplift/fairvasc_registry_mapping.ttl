	rr:predicateObjectMap [
		rr:predicate fvc:severe;
		rr:objectMap [
			rr:column "IS_SEVERE";
			rr:datatype xsd:boolean;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:complicationType;
		rr:objectMap [
			rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{COMPLICATION_TYPE}";
		];
	];
.


<#complications_thromboembolism>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			CASE WHEN complications_type = 'TBE' 
				THEN CASE 
					WHEN thromboembolic_events_dvt IS NOT NULL THEN 'C49343' --Deep Vein Thrombosis
					WHEN thromboembolic_events_pe IS NOT NULL THEN 'C50713'  --Pulmonary Embolism
					ELSE 'C143873' --thromboembolic event
				END	
			END AS complication_type, 
			CASE WHEN complications_type = 'TBE' THEN FORMATDATETIME(PARSEDATETIME(date_of_complication, 'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' END AS complication_date	
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/complication/thromboembolism/{RECORD_ID}_{COMPLICATION_TYPE}_{COMPLICATION_DATE}" ;
		rr:class fvc:ComplicationThromboembolism;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:dateOfComplications;
		rr:objectMap [
			rr:column "COMPLICATION_DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:complicationType;
		rr:objectMap [
			rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{COMPLICATION_TYPE}";
		];
	];
.


