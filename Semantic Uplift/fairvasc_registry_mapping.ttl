			CASE WHEN induction_treatment___l04ax01 = 1 THEN 'C290' END AS treatment_encoding, --azathioprine
			CASE WHEN induction_treatment___l04ax01 = 1 THEN 'C38288' END AS route_of_administration --oral 
		FROM FV_PatientData	
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/overview/treatment/induction/{RECORD_ID}_{TREATMENT_ENCODING}";
