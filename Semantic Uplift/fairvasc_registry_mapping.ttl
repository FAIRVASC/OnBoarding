			urine_pcr,
			CASE WHEN urine_pcr IS NOT NULL THEN 'C79463' END AS test_type, --Protein To Creatinine Ratio Measurement
			CASE WHEN urine_pcr IS NOT NULL THEN 'C73721' END AS test_unit --Gram per Mole = milligram per millimole
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/clinical_test/{RECORD_ID}_{DATE_OF_ENCOUNTER}_{TEST_TYPE}";
		rr:class fvc:UrinePcrTest;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:testValue;
		rr:objectMap [
			rr:column "URINE_PCR";
			rr:datatype xsd:double;
		];
	];	


	rr:predicateObjectMap [
		rr:predicate fvc:testDate;
		rr:objectMap [
			rr:column "DATE_OF_ENCOUNTER";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:testType;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TEST_TYPE}"];
	];

	
	rr:predicateObjectMap [
		rr:predicate fvc:testUnit;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TEST_UNIT}"];
	];
.


########## Here follows the BVAS section and all related sections:  ############


<#bvas>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			total_score,
			CASE WHEN persistent = 1 THEN 'true' WHEN persistent = 0 THEN 'false' END AS is_persistent,
			CASE WHEN total_score = 0 THEN 0 ELSE number_of_major_bvas_items END AS major_items_count,
			CASE WHEN total_score = 0 THEN 0 ELSE number_of_minor_bvas_items END AS minor_items_count
		FROM FV_PatientData	
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVAS;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:dateOfEncounter;
		rr:objectMap [
			rr:column "BVAS_DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:bvasScore;
		rr:objectMap [
			rr:column "TOTAL_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:bvasPersistent;
		rr:objectMap [
			rr:column "IS_PERSISTENT";
			rr:datatype xsd:boolean;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:numberOfMajorBVASItems;
		rr:objectMap [
			rr:column "MAJOR_ITEMS_COUNT";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:numberOfMinorBVASItems;
		rr:objectMap [
			rr:column "MINOR_ITEMS_COUNT";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASAbdominal;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_abdominal>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASCardiovascular;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_cardiovascular>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASChest;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_chest>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASCutaneous;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_cutaneous>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASENT;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_ent>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASGeneral;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_general>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASMucousMembraneEyes;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_mucous_membranes_eyes>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASNervousSystem;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_nervous_system>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hasBVASRenal;
		rr:objectMap [
			rr:parentTriplesMap <#bvas_renal>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
			rr:joinCondition [
				rr:child "BVAS_DATE";
				rr:parent "BVAS_DATE";
			];
		];
	];
.


<#bvas_abdominal>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			abdom_score,
			CASE 
				WHEN persistent = 0 THEN abdom_perit * 9 
				WHEN persistent = 1 THEN abdom_perit * 3 
			END AS peritonitis,
			CASE
				WHEN persistent = 0 THEN abdom_bld_dia * 9
				WHEN persistent = 1 THEN abdom_bld_dia * 3
			END AS bloody_diarrhoea,
			CASE
				WHEN persistent = 0 THEN abdom_isch_abd_p * 6
				WHEN persistent = 1 THEN abdom_isch_abd_p * 2
			END AS isch_abd_pain
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/abdominal/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVASAbdominal;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:abdominalScore;
		rr:objectMap [
			rr:column "ABDOM_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:peritonitisScore;
		rr:objectMap [
			rr:column "PERITONITIS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:bloodyDiarrhoeaScore;
		rr:objectMap [
			rr:column "BLOODY_DIARRHOEA";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:ischaemicAbdominalPainScore;
		rr:objectMap [
			rr:column "ISCH_ABD_PAIN";
			rr:datatype xsd:int;
		];
	];	
.


<#bvas_cardiovascular>

	rr:logicalTable [ rr:sqlQuery """
		SELECT 
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			cardio_score,
			CASE
				WHEN persistent = 0 THEN cardio_loss_p *4 
				WHEN persistent = 1	THEN cardio_loss_p 
			END AS loss_of_pulses,
			CASE
				WHEN persistent = 0 THEN cardio_val_hrt_d *4 
				WHEN persistent = 1	THEN cardio_val_hrt_d *2
			END AS valv_heart_dis,
			CASE
				WHEN persistent = 0 THEN cardio_peric *3
				WHEN persistent = 1	THEN cardio_peric
			END AS pericarditis,
			CASE
				WHEN persistent = 0 THEN cardio_isch_card_p *4 
				WHEN persistent = 1	THEN cardio_isch_card_p *2
			END AS isch_cardiac_pain,
			CASE
				WHEN persistent = 0 THEN cardio_cardmyp *6 
				WHEN persistent = 1	THEN cardio_cardmyp *3
			END AS cardiomyopathy, 
			CASE
				WHEN persistent = 0 THEN cardio_cong_card_f *6 
				WHEN persistent = 1	THEN cardio_cong_card_f *3
			END AS cong_cardiac_fail															 
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/cardiovascular/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVASCardiovascular;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:cardiovascularScore;
		rr:objectMap [
			rr:column "CARDIO_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:lossOfPulseScore;
		rr:objectMap [
			rr:column "LOSS_OF_PULSES";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:valvulvarHeartDiseaseScore;
		rr:objectMap [
			rr:column "VALV_HEART_DIS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:pericarditisScore;
		rr:objectMap [
			rr:column "PERICARDITIS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:ischaemicCardiacPainScore;
		rr:objectMap [
			rr:column "ISCH_CARDIAC_PAIN";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:cardiomyopathyScore;
		rr:objectMap [
			rr:column "CARDIOMYOPATHY";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:congestiveCardiacFailureScore;
		rr:objectMap [
			rr:column "CONG_CARDIAC_FAIL";
			rr:datatype xsd:int;
		];
	];
.


<#bvas_chest>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			chest_score,
			CASE
				WHEN persistent = 0 THEN chest_wheeze *2
				WHEN persistent = 1 THEN chest_wheeze *1
			END AS wheeze,	
			CASE
				WHEN persistent = 0 THEN chest_nod_o_cav *3
			END AS nod_or_cav, --whereas this is not applicable in case of persistent BVAS
			CASE
				WHEN persistent = 0 THEN chest_pleu_eff *4 
				WHEN persistent = 1	THEN chest_pleu_eff *2
			END AS pleu_effusion,				
			CASE
				WHEN persistent = 0 THEN chest_infilt *4
				WHEN persistent = 1	THEN chest_infilt *2
			END AS infiltrate,
			CASE
				WHEN persistent = 0 THEN chest_endbrn_i *4
				WHEN persistent = 1	THEN chest_endbrn_i *2
			END AS endobro_inv,
			CASE
				WHEN persistent = 0 THEN chest_msv_haem *6
				WHEN persistent = 1	THEN chest_msv_haem *4 
			END AS mass_haemopt,
			CASE
				WHEN persistent = 0 THEN chest_resp_fail *6 
				WHEN persistent = 1	THEN chest_resp_fail *4
			END AS resp_fail																			
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/chest/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVASChest;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:chestScore;
		rr:objectMap [
			rr:column "CHEST_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:wheezeScore;
		rr:objectMap [
			rr:column "WHEEZE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:nodulesScore;
		rr:objectMap [
			rr:column "NOD_OR_CAV";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:pleurisyScore;
		rr:objectMap [
			rr:column "PLEU_EFFUSION";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:infiltrateScore;
		rr:objectMap [
			rr:column "INFILTRATE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:endobronchialScore;
		rr:objectMap [
			rr:column "ENDOBRO_INV";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:haemoptysisScore;
		rr:objectMap [
			rr:column "MASS_HAEMOPT";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:respiratoryFailureScore;
		rr:objectMap [
			rr:column "RESP_FAIL";
			rr:datatype xsd:int;
		];
	];
.


<#bvas_cutaneous>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			cutaneous_score,
			CASE
				WHEN persistent = 0 THEN cutaneous_infarct *2
				WHEN persistent = 1 THEN cutaneous_infarct
