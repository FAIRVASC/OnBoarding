<#anca>


	rr:logicalTable [ rr:sqlQuery """
	SELECT 
		record_id,
		CASE 
			WHEN anca_if_en = 'C' THEN 'cANCA positive'
			WHEN anca_if_en = 'P' THEN 'pANCA positive'
			WHEN anca_if_en = 'A' THEN 'Atypical'
			WHEN anca_if_en = 'N' THEN 'Negative'
			WHEN anca_if_en = 'U' THEN 'Not tested'
		END AS anca_if,
		CASE
			WHEN anca_elisa = 'MP' THEN 'MPO and PR3 positive'
			WHEN anca_elisa = 'M' THEN 'MPO positive'
			WHEN anca_elisa = 'EN' THEN 'ELISA negative'
			WHEN anca_elisa = 'PR' THEN 'PR3 positive'
			WHEN anca_elisa = 'O' THEN 'Other'
			WHEN anca_elisa = 'NE' THEN 'No Elisa performed'
		END AS anca_spec,

	FROM FV_PatientData
	""" ] ;


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/anca/{RECORD_ID}" ;
		rr:class fvc:ANCA ;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:ancaIF ;
		rr:objectMap [
			rr:column "ANCA_IF" ;
			rr:datatype xsd:string ;
		] ;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:ancaSpec ;
		rr:objectMap [
			rr:column "ANCA_SPEC" ;
			rr:datatype xsd:string ;
		] ;
	] ;
	
.


<#creatinine_at_diagnosis>

	rr:logicalTable [ rr:sqlQuery """
	WITH main_form AS (
		SELECT record_id, date_of_diagnosis
		FROM FV_PatientData
		WHERE redcap_repeat_instrument IS NULL
	),
	followup_form AS (
		SELECT record_id, followup_date, creatinine_umol_l
		FROM FV_PatientData
		WHERE redcap_repeat_instrument = 'annual_or_encounter_followup'
	),
	days_since_diagnosis AS (
		SELECT 
			main_form.record_id, 
			main_form.date_of_diagnosis, 
			followup_form.followup_date, 
			followup_form.creatinine_umol_l, 
			ABS(DATEDIFF(day,
				PARSEDATETIME(followup_form.followup_date, 'yyyy-mm-dd'), 
				PARSEDATETIME(main_form.date_of_diagnosis, 'yyyy-mm-dd'))) 
			AS diff_days
		FROM main_form JOIN followup_form ON main_form.record_id = followup_form.record_id
	)
	SELECT 
		record_id, 
		date_of_diagnosis,
		MIN(CASE WHEN diff_days <= 60 THEN FORMATDATETIME(PARSEDATETIME(followup_date,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' END) AS followup_date_closest_to_diagnosis,
		MIN(CASE WHEN diff_days <= 60 THEN creatinine_umol_l END) AS creatinine_at_diagnosis,
		MIN(CASE WHEN diff_days <= 60 AND creatinine_umol_l IS NOT NULL THEN 'C61023' END) AS test_type, -- Serum Creatinine Measurement 
        MIN(CASE WHEN diff_days <= 60 AND creatinine_umol_l IS NOT NULL THEN 'C48508' END) AS test_unit -- Micromoles per liter   
	FROM days_since_diagnosis
	GROUP BY record_id, date_of_diagnosis
	""" ] ;


	rr:subjectMap[
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/clinical_test/creatinine/{RECORD_ID}_{FOLLOWUP_DATE_CLOSEST_TO_DIAGNOSIS}" ;
		rr:class fvc:CreatinineTest;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:testDate ;
		rr:objectMap [			
			rr:column "FOLLOWUP_DATE_CLOSEST_TO_DIAGNOSIS" ;
			rr:datatype xsd:dateTime;
		] ;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:testValue;
		rr:objectMap [			
			rr:column "CREATININE_AT_DIAGNOSIS" ;
			rr:datatype xsd:double;
		] ;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:testUnit;			
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TEST_UNIT}"];
    ];	


	rr:predicateObjectMap [
		rr:predicate fvc:testType;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TEST_TYPE}"];
    ];


.


<#organ_pattern_specific>

	rr:logicalTable [ rr:sqlQuery """
	SELECT 
		record_id,
		CASE WHEN systems_involved___k = 1 THEN 'Kidney' END AS kidney_involvement,
		CASE WHEN systems_involved___lg = 1 THEN 'Pulmonary granuloma' END AS pulmonary_granuloma,
		CASE WHEN systems_involved___lh = 1 THEN 'Pulmonary hemorrhage' END AS pulmonary_hemorrhage,
		CASE WHEN systems_involved___li = 1 THEN 'Interstitial lung disease' END AS interstitial_lung_disease,
		CASE WHEN systems_involved___lg = 1 OR systems_involved___lh = 1 OR systems_involved___li = 1   
			THEN 'Lung' END AS lung_involvement,
		CASE WHEN systems_involved___ent = 1 THEN 'Ear/Nose/Throat' END AS ent_involvement,
		CASE WHEN systems_involved___t = 1 THEN 'Tracheal' END AS tracheal_involvement,
		CASE WHEN systems_involved___mt = 1 THEN 'Mucocutaneous' END AS mucocutaneous_involvement,
		CASE WHEN systems_involved___ms = 1 THEN 'Musculoskeletal' END AS musculoskeletal_involvement,
		CASE WHEN systems_involved___cns = 1 THEN 'Central nervous system' END AS cns_involvement,
		CASE WHEN systems_involved___pns = 1 THEN 'Peripheral nervous system' END AS pns_involvement,
		CASE WHEN systems_involved___a = 1 THEN 'Abdominal' END AS abdominal_involvement,
		CASE WHEN systems_involved___e = 1 THEN 'Eye' END AS ocular_involvement,
		CASE WHEN systems_involved___c = 1 THEN 'Cardiovascular' END AS cardiovascular_involvement
	FROM FV_PatientData
	""" ] ;


