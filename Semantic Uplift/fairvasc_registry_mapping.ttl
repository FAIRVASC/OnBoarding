<#patient_clinical_outcome>

	rr:logicalTable [ rr:sqlQuery """
		WITH main_form AS (
				SELECT
					record_id,
					CASE WHEN date_of_death IS NOT NULL OR cause_of_death IS NOT NULL THEN 'true' ELSE 'false' END AS is_dead,
					FORMATDATETIME(PARSEDATETIME(date_of_death,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS death_date,
					CASE 
						WHEN cause_of_death = 'V' THEN 'Vasculitis'
						WHEN cause_of_death = 'U' THEN 'Unknown'
						WHEN cause_of_death_known_snome = '355001' THEN 'Other' -- Hemorrhagic Shock
						WHEN cause_of_death_known_snome = '42343007' THEN 'Cardiovascular' -- Congestive Heart Failure
						WHEN cause_of_death_known_snome = '409623005' THEN 'Other' -- Respiratory Insufficiency 
						WHEN cause_of_death_known_snome = '840533007' THEN 'Infection' -- SARS-CoV 2
					END AS death_cause	
				FROM FV_PatientData
				WHERE redcap_repeat_instrument IS NULL
			),
			dialysis_form AS (
				SELECT
					record_id,
					CASE WHEN date_dialysis_start IS NOT NULL OR dialysis_type IS NOT NULL OR date_dialysis_stop IS NOT NULL THEN 'true' ELSE 'false' END AS is_dialysed
				FROM FV_PatientData
				WHERE redcap_repeat_instrument = 'dialysis_optional' 
			),
			eskd_form AS (
				SELECT
					record_id,
					CASE WHEN renal_event IS NOT NULL THEN 'true' ELSE 'false' END AS is_eskd,
					FORMATDATETIME(PARSEDATETIME(renal_event_date,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS eskd_date
				FROM FV_PatientData
				WHERE redcap_repeat_instrument = 'eskd_outcomes_optional' 
			),
			last_followup_form AS (
				SELECT
					record_id,
					FORMATDATETIME(MAX(PARSEDATETIME(followup_date,'yyyy-mm-dd')),'yyyy-mm-dd')||'T00:00:00' AS last_followup_date
				FROM FV_PatientData
				WHERE redcap_repeat_instrument = 'annual_or_encounter_followup'
				GROUP BY record_id
			)
		SELECT
			main_form.record_id,
			main_form.is_dead,
			main_form.death_date,
			main_form.death_cause,
			dialysis_form.is_dialysed,
			eskd_form.is_eskd,
			eskd_form.eskd_date,
			CASE 
				WHEN main_form.death_date IS NOT NULL THEN main_form.death_date 
				ELSE last_followup_form.last_followup_date 
			END AS last_contact
		FROM main_form
		LEFT JOIN dialysis_form ON main_form.record_id = dialysis_form.record_id
		LEFT JOIN eskd_form ON main_form.record_id = eskd_form.record_id
		LEFT JOIN last_followup_form ON main_form.record_id = last_followup_form.record_id
	""" ] ;


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/outcomes/{RECORD_ID}" ;
		rr:class fvc:ClinicalOutcomes ;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:ESKDStandard;
		rr:objectMap [
			rr:column "IS_ESKD";
			rr:datatype xsd:boolean;
		];
	];


	rr:predicateObjectMap [
