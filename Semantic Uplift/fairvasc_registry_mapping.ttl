			rr:datatype xsd:string;
		];
	];
.


<#complications_malignancy>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			CASE WHEN complications_type = 'MLG' THEN 'C9305' END AS complication_type, --malignant neoplasm
			CASE WHEN complications_type = 'MLG' THEN FORMATDATETIME(PARSEDATETIME(date_of_complication, 'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' END AS complication_date,
			CASE 
				WHEN malignancy_comp_serv_2 = 1 THEN 'ctcae_mild_selfmanaged'  
				WHEN malignancy_comp_serv_2 = 2 THEN 'ctcae_moderate_outpatient'
				WHEN malignancy_comp_serv_2 = 3 THEN 'ctcae_severe_inpatient'
				WHEN malignancy_comp_serv_2 = 4 THEN 'ctcae_life_threatening'
				WHEN malignancy_comp_serv_2 = 5 THEN 'ctcae_death'
			END AS complication_severity,
			CASE 
				WHEN malignancy_comp_serv_2 IN (1, 2) THEN 'false'  
				WHEN malignancy_comp_serv_2 IN (3, 4, 5) THEN 'true'
			END AS is_severe	
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/complication/malignancy/{RECORD_ID}_{COMPLICATION_TYPE}_{COMPLICATION_DATE}" ;
		rr:class fvc:ComplicationMalignancy;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:dateOfComplications;
		rr:objectMap [
			rr:column "COMPLICATION_DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:complicationSeverity;
		rr:objectMap [
			rr:column "COMPLICATION_SEVERITY";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:severe;
		rr:objectMap [
			rr:column "IS_SEVERE";
			rr:datatype xsd:boolean;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:complicationType;
		rr:objectMap [
			rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{COMPLICATION_TYPE}";
		];
	];
.


<#complications_cardiovascular>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			CASE WHEN complications_type = 'CVC' THEN 'C115199' END AS complication_type, --cardiovascular complication
			CASE WHEN complications_type = 'CVC' THEN FORMATDATETIME(PARSEDATETIME(date_of_complication, 'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' END AS complication_date,
			CASE 
				WHEN cardiovascular_comp_2 = 1 THEN 'ctcae_mild_selfmanaged'  
				WHEN cardiovascular_comp_2 = 2 THEN 'ctcae_moderate_outpatient'
				WHEN cardiovascular_comp_2 = 3 THEN 'ctcae_severe_inpatient'
				WHEN cardiovascular_comp_2 = 4 THEN 'ctcae_life_threatening'
				WHEN cardiovascular_comp_2 = 5 THEN 'ctcae_death'
			END AS complication_severity,
			CASE 
				WHEN cardiovascular_comp_2 IN (1, 2) THEN 'false'
				WHEN cardiovascular_comp_2 IN (3, 4, 5) THEN 'true' 
			END AS is_severe	
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/complication/cardiovascular/{RECORD_ID}_{COMPLICATION_TYPE}_{COMPLICATION_DATE}" ;
		rr:class fvc:ComplicationCardiovascular;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:dateOfComplications;
		rr:objectMap [
			rr:column "COMPLICATION_DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:complicationSeverity;
		rr:objectMap [
			rr:column "COMPLICATION_SEVERITY";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:severe;
		rr:objectMap [
			rr:column "IS_SEVERE";
			rr:datatype xsd:boolean;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:complicationType;
		rr:objectMap [
			rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{COMPLICATION_TYPE}";
		];
	];
.


<#complications_infection>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			CASE WHEN complications_type = 'INF' THEN 'C26726' END AS complication_type, --infection
			CASE WHEN complications_type = 'INF' THEN FORMATDATETIME(PARSEDATETIME(date_of_complication, 'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' END AS complication_date,
			CASE 
				WHEN infection_severity = 1 THEN 'ctcae_mild_selfmanaged'  
				WHEN infection_severity = 2 THEN 'ctcae_moderate_outpatient'
				WHEN infection_severity = 3 THEN 'ctcae_severe_inpatient'
				WHEN infection_severity = 4 THEN 'ctcae_life_threatening'
				WHEN infection_severity = 5 THEN 'ctcae_death'
			END AS complication_severity,
			CASE 
				WHEN infection_severity IN (1, 2) THEN 'false'
				WHEN infection_severity IN (3, 4, 5) THEN 'true'
			END AS is_severe	
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/complication/infection/{RECORD_ID}_{COMPLICATION_TYPE}_{COMPLICATION_DATE}" ;
		rr:class fvc:ComplicationInfection;
	] ;


	rr:predicateObjectMap [
