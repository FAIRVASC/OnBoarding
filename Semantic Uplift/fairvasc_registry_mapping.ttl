######################## Here follows the Patient section and all the sections that are directly linked to it: ##################

<#patient>


	rr:logicalTable [ rr:sqlQuery """
		WITH main_form AS (
				SELECT
					record_id,
					year_of_birth,
					CASE
						WHEN gender = 'M' THEN 'C20197'
						WHEN gender = 'F' THEN 'C16576'
						WHEN gender = 'U' THEN 'C41438'
					END AS gender_ncit
				FROM FV_PatientData
				WHERE redcap_repeat_instrument IS NULL
			),
			complications_form AS (
				SELECT
					record_id,
					FORMATDATETIME(PARSEDATETIME(date_of_complication, 'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS complication_date,
					CASE 
						WHEN complications_type = 'MLG' THEN 'C9305' --malignant neoplasm
						WHEN complications_type = 'CVC' THEN 'C115199' --cardiovascular complication
						WHEN complications_type = 'INF' THEN 'C128320' --infection
						WHEN complications_type = 'TBE' THEN 'C143873' --thromboembolic event 
					END AS complication_type				
				FROM FV_PatientData
				WHERE redcap_repeat_instrument = 'complications_optional'
			),
			bvas_form AS (
				SELECT 
					record_id,
					FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date
				FROM FV_PatientData
				WHERE redcap_repeat_instrument = 'bvas_optional' 
			),
			followup_form AS (
				SELECT
					record_id,
					FORMATDATETIME(PARSEDATETIME(followup_date,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS date_of_encounter
				FROM FV_PatientData
				WHERE redcap_repeat_instrument = 'annual_or_encounter_followup' 
			)
		SELECT 
			main_form.record_id,
			main_form.year_of_birth,
			main_form.gender_ncit,
			complications_form.complication_date,
			complications_form.complication_type,
			bvas_form.bvas_date,
			followup_form.date_of_encounter			
		FROM main_form
		LEFT JOIN complications_form ON main_form.record_id = complications_form.record_id
		LEFT JOIN bvas_form ON main_form.record_id = bvas_form.record_id
		LEFT JOIN followup_form ON main_form.record_id = followup_form.record_id
	""" ];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/patient/{RECORD_ID}" ;
		rr:class fvc:Patient;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:patientID ;
		rr:objectMap [			
			rr:column "RECORD_ID" ;
			rr:datatype xsd:string;
		] ;
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:gender ;
		rr:objectMap [ rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{GENDER_NCIT}" ];
	] ;


	rr:predicateObjectMap [
		rr:predicate fvc:yearOfBirth ;
		rr:objectMap [			
			rr:column "YEAR_OF_BIRTH" ;
			rr:datatype xsd:gYear;
		] ;
	] ;


