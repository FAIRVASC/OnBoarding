<#bvas_mucous_membranes_eyes>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			muc_mb_e_score,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_m_ulc_gra *2
				WHEN persistent = 1 THEN muc_mb_e_m_ulc_gra
			END AS mouth_ulcers,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_gen_ulc 
				WHEN persistent = 1 THEN muc_mb_e_gen_ulc
			END AS genital_ulcers,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_ad_inf *4
				WHEN persistent = 1 THEN muc_mb_e_ad_inf *2
			END AS adnexal_infl,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_sig_prop *4
				WHEN persistent = 1 THEN muc_mb_e_sig_prop *2
			END AS sign_proptosis,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_scle_epis *2
				WHEN persistent = 1 THEN muc_mb_e_scle_epis 
			END AS scler_or_episcler,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_con_ble_ker
				WHEN persistent = 1 THEN muc_mb_e_con_ble_ker
			END AS conj_ble_ker,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_blur_v *3
				WHEN persistent = 1 THEN muc_mb_e_blur_v *2
			END AS blurred_vision,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_sud_v_loss *6
			END AS sudden_v_loss, --whereas this is not applicable in case of persistent BVAS
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_uveitis *6
				WHEN persistent = 1 THEN muc_mb_e_uveitis *2
			END AS uveitis,
			CASE 
				WHEN persistent = 0 THEN muc_mb_e_ret_chng *6
				WHEN persistent = 1 THEN muc_mb_e_ret_chng *2
			END AS retinal_changes																											
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/mucousmembraneseyes/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVASMucousMembraneEyes;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:mucousScore;
		rr:objectMap [
			rr:column "MUC_MB_E_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:mouthUlcersScore;
		rr:objectMap [
			rr:column "MOUTH_ULCERS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:genitalUlcersScore;
		rr:objectMap [
			rr:column "GENITAL_ULCERS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:adnexalScore;
		rr:objectMap [
			rr:column "ADNEXAL_INFL";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:proptosisScore;
		rr:objectMap [
			rr:column "SIGN_PROPTOSIS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:scleritisScore;
		rr:objectMap [
			rr:column "SCLER_OR_EPISCLER";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:conjunctivitisScore;
		rr:objectMap [
			rr:column "CONJ_BLE_KER";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:blurredVisionScore;
		rr:objectMap [
			rr:column "BLURRED_VISION";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:suddenVisualLossScore;
		rr:objectMap [
			rr:column "SUDDEN_V_LOSS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:uveitisScore;
		rr:objectMap [
			rr:column "UVEITIS";
			rr:datatype xsd:int;
		];
	];

	rr:predicateObjectMap [
			rr:predicate bvas:retinalChangesScore;
			rr:objectMap [
				rr:column "RETINAL_CHANGES";
				rr:datatype xsd:int;
			];
		];
.


<#bvas_nervous_system>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			nerv_sys_score,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_hdache 
				WHEN persistent = 1 THEN nerv_sys_hdache
			END AS headache,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_mengts *3 
				WHEN persistent = 1 THEN nerv_sys_mengts
			END AS meningitis,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_org_conf *3  
				WHEN persistent = 1 THEN nerv_sys_org_conf
			END AS organic_confusion, 
			CASE 
				WHEN persistent = 0 THEN nerv_sys_szr *9 
				WHEN persistent = 1 THEN nerv_sys_szr *3
			END AS seizures,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_stroke *9
				WHEN persistent = 1 THEN nerv_sys_stroke *3
			END AS stroke, 
			CASE 
				WHEN persistent = 0 THEN nerv_sys_spn_cor_ls *9
				WHEN persistent = 1 THEN nerv_sys_spn_cor_ls *3
			END AS spin_cord_les,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_crn_nrv_p *6
				WHEN persistent = 1 THEN nerv_sys_crn_nrv_p *3
			END AS cran_nerve_palsy,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_sn_prph_n *6
				WHEN persistent = 1 THEN nerv_sys_sn_prph_n *3
			END AS sens_peri_neurop,
			CASE 
				WHEN persistent = 0 THEN nerv_sys_mon_mult *9
				WHEN persistent = 1 THEN nerv_sys_mon_mult *3
			END AS monon_multiplex																							
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/nervoussystem/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVASNervousSystem;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:nervousSystemScore;
		rr:objectMap [
			rr:column "NERV_SYS_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:headacheScore;
		rr:objectMap [
			rr:column "HEADACHE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:meningitisScore;
		rr:objectMap [
			rr:column "MENINGITIS";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:organicConfusionScore;
		rr:objectMap [
			rr:column "ORGANIC_CONFUSION";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:seizuresScore;
		rr:objectMap [
			rr:column "SEIZURES";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:spinalCordLesionScore;
		rr:objectMap [
			rr:column "SPIN_CORD_LES";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:cranialNervePalsyScore;
		rr:objectMap [
			rr:column "CRAN_NERVE_PALSY";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:sensoryPeripheralNeuropathyScore;
		rr:objectMap [
			rr:column "SENS_PERI_NEUROP";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:mononeuritisMultiplexScore;
		rr:objectMap [
			rr:column "MONON_MULTIPLEX";
			rr:datatype xsd:int;
		];
	];
.


<#bvas_renal>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(date_bvas,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS bvas_date,
			renal_score,
			CASE
				WHEN persistent = 0 THEN renal_hypert *4
				WHEN persistent = 1 THEN renal_hypert
			END AS hypertension, 
			CASE
				WHEN persistent = 0 THEN renal_protur *4
				WHEN persistent = 1 THEN renal_protur *2
			END AS proteinuria,
			CASE
				WHEN persistent = 0 THEN renal_hmur *6
				WHEN persistent = 1 THEN renal_hmur *3
			END AS haematuria,
			CASE
				WHEN persistent = 0 THEN renal_s_crt_125 *4
				WHEN persistent = 1 THEN renal_s_crt_125 *2
			END AS s_creat_125,
			CASE
				WHEN persistent = 0 THEN renal_s_crt_250 *6
				WHEN persistent = 1 THEN renal_s_crt_250 *3
			END AS s_creat_250,
			CASE
				WHEN persistent = 0 THEN renal_s_crt_500 *8
				WHEN persistent = 1 THEN renal_s_crt_500 *4
			END AS s_creat_500,
			CASE
				WHEN persistent = 0 THEN renal_rof_crt *6
			END AS rise_in_creatinine --whereas this is not applicable in case of persistent BVAS																		
		FROM FV_PatientData	
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/BVAS/resource/italivas/BVAS/renal/{RECORD_ID}_{BVAS_DATE}";
		rr:class bvas:BVASRenal;
	];


	rr:predicateObjectMap [
		rr:predicate bvas:renalScore;
		rr:objectMap [
			rr:column "RENAL_SCORE";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:hypertensionScore;
		rr:objectMap [
			rr:column "HYPERTENSION";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:proteinuriaScore;
		rr:objectMap [
			rr:column "PROTEINURIA";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:haematuriaScore;
		rr:objectMap [
			rr:column "HAEMATURIA";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:serumCreatine1Score;
		rr:objectMap [
			rr:column "S_CREAT_125";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:serumCreatine2Score;
		rr:objectMap [
			rr:column "S_CREAT_250";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:serumCreatine3Score;
		rr:objectMap [
			rr:column "S_CREAT_500";
			rr:datatype xsd:int;
		];
	];


	rr:predicateObjectMap [
		rr:predicate bvas:creatineChangeScore;
		rr:objectMap [
			rr:column "RISE_IN_CREATININE";
			rr:datatype xsd:int;
		];
	];
.

########## Here follows the registry_consent section: ############

<#registry_consent>


	rr:logicalTable [rr:sqlQuery """
		SELECT record_id FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/registry_consent/{RECORD_ID}" ;
		rr:class dpv:ConsentRecord;
	];


	rr:predicateObjectMap [
		rr:predicate rdf:type;
		rr:objectMap [rr:constant fvc:RegistryConsent];
	];


	rr:predicateObjectMap [
		rr:predicate rdf:type;
		rr:objectMap [rr:constant fvc:BiobankConsent];
	];


	rr:predicateObjectMap [
		rr:predicate dpv:hasConsentStatus;
		rr:objectMap [rr:constant dpv:ConsentGiven];	
	];


	rr:predicateObjectMap [
		rr:predicate dpv:isIndicatedBy;
		rr:objectMap [
			rr:parentTriplesMap <#patient>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate dpv:hasDataSubject;
		rr:objectMap [
			rr:parentTriplesMap <#patient>;
			rr:joinCondition [
				rr:child "RECORD_ID";
				rr:parent "RECORD_ID";
			];
		];
	];	
.


########## Here follows the provenance_acitivty_uplift section and all related sections: #########

<#provenance_activity_uplift>


	rr:logicalTable [rr:sqlQuery """
		SELECT SUBSTRING(CURRENT_TIMESTAMP, 1, 10)||'T00:00:00' as date FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/provenance/uplift/{DATE}";
		rr:class fvc:ProvenanceActivityUplift;
	];		


	rr:predicateObjectMap [
		rr:predicate prov:startedAtTime;
		rr:objectMap [
			rr:column "DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:endedAtTime;
		rr:objectMap [
			rr:column "DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:used;
		rr:objectMap [
			rr:parentTriplesMap <#csv_file>;
			rr:joinCondition [
				rr:child "DATE";
				rr:parent "DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:wasAssociatedWith;
		rr:objectMap [
			rr:parentTriplesMap <#italivas_person_michelangelo>;
			rr:joinCondition [
				rr:child "DATE";
				rr:parent "DATE";
			];
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:used;
		rr:objectMap [
		rr:parentTriplesMap <#r2rml_file> ;
		rr:joinCondition [
			rr:child "DATE" ;
			rr:parent "DATE" ;
		] ;
		] ;
	];	


	rr:predicateObjectMap [
		rr:predicate prov:generated;
		rr:objectMap [
			rr:parentTriplesMap <#italivas_graph> ;
			rr:joinCondition [
				rr:child "DATE" ;
				rr:parent "DATE" ;
			] ;
		] ;
	];
.


<#csv_file>


	rr:logicalTable [rr:sqlQuery """
		SELECT SUBSTRING(CURRENT_TIMESTAMP, 1, 10)||'T00:00:00' as date FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/provenance/uplift/csv_file/{DATE}";
		rr:class prov:Entity;	
	];


	rr:predicateObjectMap [
		rr:predicate dcterms:title;
		rr:objectMap [
			rr:template "italivas CSV file";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:generatedAtTime ;
		rr:objectMap [ rr:template "2023-07-04T00:00:00"; rr:datatype xsd:dateTime];	
	] ;


	rr:predicateObjectMap [
		rr:predicate prov:wasAttributedTo;
		rr:objectMap [
			rr:parentTriplesMap <#italivas_person_michelangelo>;
			rr:joinCondition [
				rr:child "DATE";
				rr:parent "DATE";
			];
		];
	];
.


<#italivas_person_michelangelo>


	rr:logicalTable[rr:sqlQuery """
		SELECT SUBSTRING(CURRENT_TIMESTAMP, 1, 10)||'T00:00:00' as date FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/person/michelangelo.tesi";
		rr:class prov:Agent;
		rr:class prov:Person;
	];


	rr:predicateObjectMap [
		rr:predicate foaf:name;
		rr:objectMap [
			rr:template "Michelangelo Tesi";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate foaf:mbox;
		rr:objectMap [rr:template "mailto:michelangelo.tesi@meyer.it"];
	];
.


<#r2rml_file>


	rr:logicalTable[rr:sqlQuery """
		SELECT SUBSTRING(CURRENT_TIMESTAMP, 1, 10)||'T00:00:00' as date FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/provenance/uplift/r2rml_file/{DATE}";
		rr:class prov:Entity;
	];


	rr:predicateObjectMap [
		rr:predicate dcterms:title;
		rr:objectMap [
			rr:template "italivas R2RML file";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:wasAttributedTo;
		rr:objectMap [
			rr:parentTriplesMap <#italivas_person_michelangelo> ;
			rr:joinCondition [
				rr:child "DATE" ;
				rr:parent "DATE" ;
			] ;
		] ;
	];


	rr:predicateObjectMap [
		rr:predicate schema:version;
		rr:objectMap [
			rr:template "This uplift used ontology version V3.0";
			rr:datatype xsd:string;
		];
	];
.


<#italivas_graph>


	rr:logicalTable [rr:sqlQuery """
		SELECT SUBSTRING(CURRENT_TIMESTAMP, 1, 10)||'T00:00:00' as date FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/provenance/uplift/italivas_graph/{DATE}";
		rr:class prov:Entity;
	];


	rr:predicateObjectMap [
		rr:predicate dcterms:title;
		rr:objectMap [
			rr:template "italivas graph";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate prov:wasGeneratedBy;
		rr:objectMap [
			rr:parentTriplesMap <#provenance_activity_uplift> ;
			rr:joinCondition [
				rr:child "DATE" ;
				rr:parent "DATE" ;
			] ;
		] ;
	];
.