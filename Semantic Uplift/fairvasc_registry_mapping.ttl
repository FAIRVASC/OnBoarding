				WHEN persistent = 0 THEN cutaneous_purp *2
				WHEN persistent = 1 THEN cutaneous_purp
			END AS purpura,
			CASE
				WHEN persistent = 0 THEN cutaneous_ulcer *4
				WHEN persistent = 1 THEN cutaneous_ulcer
			END AS ulcer,
			CASE
				WHEN persistent = 0 THEN cutaneous_gangre *6 
				WHEN persistent = 1 THEN cutaneous_gangre *2
			END AS gangrene,
			CASE
				WHEN persistent = 0 THEN cutaneous_o_sk_vas *2
				WHEN persistent = 1 THEN cutaneous_o_sk_vas 
