		rr:template "http://w3id.org/FAIRVASC/resource/italivas/overview/treatment/maintenance/{RECORD_ID}_{TREATMENT_ENCODING}_{ROUTE_OF_ADMINISTRATION}";
		rr:class fvc:TreatmentMaintenance;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:treatmentType;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TREATMENT_ENCODING}"];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:routeToAdministration;
		rr:objectMap [
			rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{ROUTE_OF_ADMINISTRATION}";
		];
	]; 
.


<#maintenance_rituximab>

	rr:logicalTable[rr:sqlQuery """
		SELECT
			record_id,
			CASE WHEN maintenance_treatment___l01xco2 = 1 THEN 'C1702' END AS treatment_encoding, --rituximab
			CASE WHEN maintenance_treatment___l01xco2 = 1 THEN 'C38276' END AS route_of_administration --intravenous  
		FROM FV_PatientData	
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/overview/treatment/maintenance/{RECORD_ID}_{TREATMENT_ENCODING}";
		rr:class fvc:TreatmentMaintenance;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:treatmentType;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TREATMENT_ENCODING}"];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:routeToAdministration;
		rr:objectMap [
			rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{ROUTE_OF_ADMINISTRATION}";
		];
	]; 
.


<#maintenance_other>

	rr:logicalTable[rr:sqlQuery """
		SELECT
			record_id,
			CASE 
				WHEN maintenance_other_atc = 'R03DX09' THEN 'C157376' -- mepolizumab
				WHEN maintenance_other_atc IN ('J06BA02','J06BA01','J06BA','J06B') THEN 'C2701' -- therapeutic immunoglobulins
				WHEN maintenance_other_atc = 'L04AA06' THEN 'C673' -- mycophenolic acid
				WHEN maintenance_other_atc = 'L01AA01' THEN 'C405' -- cyclophosphamide
				WHEN maintenance_other_atc = 'S01XA18' THEN 'C406' -- cyclosporin
			END AS treatment_encoding
		FROM FV_PatientData	
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/overview/treatment/maintenance/{RECORD_ID}_{TREATMENT_ENCODING}";
		rr:class fvc:TreatmentMaintenance;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:treatmentType;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TREATMENT_ENCODING}"];
	]; 
.


###################  Here follow all the sections related to clinical tests:   ############################


<#clinical_test_mpo_titre>

	rr:logicalTable [rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(followup_date,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS date_of_encounter,
			CASE 
				WHEN mpo_anca_level_lab_an = 'P' THEN 'Positive'
				WHEN mpo_anca_level_lab_an = 'N' THEN 'Negative'
				WHEN mpo_anca_level_lab_an = 'NP' THEN 'Not available'
			END AS mpo_anca_titre	 
		FROM FV_PatientData
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/clinical_test/mpo/{RECORD_ID}_{DATE_OF_ENCOUNTER}";
		rr:class fvc:MpoTest;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:mpoTitreDefault;
		rr:objectMap [
			rr:column "MPO_ANCA_TITRE";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:testDate;
		rr:objectMap [
			rr:column "DATE_OF_ENCOUNTER";
			rr:datatype xsd:dateTime;
		];
	];
.


