<#diagnosis>

	rr:logicalTable [ rr:sqlQuery """
		SELECT 
			record_id,
			small_vessel_vas_anca,
			age_diagnosis, 
			age_onset, 
			FORMATDATETIME(PARSEDATETIME(date_of_diagnosis, 'yyyy-mm-dd'), 'yyyy-MM-dd')||'T00:00:00' AS diagnosis_date,
			FORMATDATETIME(PARSEDATETIME(date_of_symptoms,'yyyy-mm-dd'), 'yyyy-MM-dd')||'T00:00:00' AS onset_date,
			CASE
				WHEN diagnosis_confidence_init = 'DE' THEN 'Definite'
				WHEN diagnosis_confidence_init = 'PR' THEN 'Probable'
				WHEN diagnosis_confidence_init = 'PO' THEN 'Possible'
			END AS diagnosis_confidence,
			CASE
				WHEN DATEDIFF(day, PARSEDATETIME(enrolment_date, 'yyyy-mm-dd'), PARSEDATETIME(date_of_diagnosis,'yyyy-mm-dd')) <= 180 THEN 'Prospective'
				WHEN DATEDIFF(day, PARSEDATETIME(enrolment_date, 'yyyy-mm-dd'), PARSEDATETIME(date_of_diagnosis,'yyyy-mm-dd')) > 180 THEN 'Retrospective'
			END AS inclusion_type
		FROM FV_PatientData 	  
	"""];


	rr:subjectMap [
		rr:template  "http://w3id.org/FAIRVASC/resource/italivas/diagnosis/{RECORD_ID}_{SMALL_VESSEL_VAS_ANCA}";
		rr:class fvc:Diagnosis;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:mainDiagnosis;
		rr:objectMap [rr:template "http://www.orpha.net/ORDO/Orphanet_{SMALL_VESSEL_VAS_ANCA}"];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:dateOfDiagnosis;
		rr:objectMap [
			rr:column "DIAGNOSIS_DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:dateOfCarePathwayStart;
		rr:objectMap [
			rr:column "DIAGNOSIS_DATE";
			rr:datatype xsd:dateTime;
		];
	];	


	rr:predicateObjectMap [
		rr:predicate fvc:ageAtDiagnosis;
		rr:objectMap [
			rr:column "AGE_DIAGNOSIS";
			rr:datatype xsd:integer;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:dateOfOnset;
		rr:objectMap [
			rr:column "ONSET_DATE";
			rr:datatype xsd:dateTime;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:ageAtOnset;
		rr:objectMap [
			rr:column "AGE_ONSET";
			rr:datatype xsd:integer;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:diagnosisClassification;
		rr:objectMap [
			rr:template "Clinical";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:diagnosisConfidence;
		rr:objectMap [
			rr:column "DIAGNOSIS_CONFIDENCE";
			rr:datatype xsd:string;
		];
	];


	rr:predicateObjectMap [
		rr:predicate fvc:inclusionType;
		rr:objectMap [
			rr:column "INCLUSION_TYPE";
			rr:datatype xsd:string;
		];
	];
.


<#comorbidities>

	rr:logicalTable [ rr:sqlQuery """
		SELECT
			record_id,
			CASE WHEN comorbid_events___195967001 = 1 THEN 'C28397' END AS asthma,
			CASE WHEN comorbid_events___49436004 = 1 THEN 'C50466' END AS atrial_fibrillation,
			CASE WHEN comorbid_events___230690007 = 1 THEN 'C3390' END AS cerebrovascular_accident,
			CASE WHEN comorbid_events___13645005 = 1 THEN 'C3199' END AS copd,
			CASE WHEN comorbid_events___414545008 = 1 THEN 'C26732' END AS coronary_artery_disease,
			CASE WHEN comorbid_events___73211009 = 1 THEN 'C2985' END AS diabetes_mellitus,
			CASE WHEN comorbid_events___55822004 = 1 THEN 'C80385' END AS dyslipidemia,
			CASE WHEN comorbid_events___38341003 = 1 THEN 'C3117' END AS hypertension,
			CASE WHEN comorbid_events___40930008 = 1 THEN 'C26800' END AS hypothyroidism,
			CASE WHEN comorbid_events___108369006 = 1 THEN 'C9305' END AS malignancy,
			CASE WHEN comorbid_events___90708001 = 1 THEN 'C3149' END AS kidney_disorder,
			CASE WHEN comorbid_events___371039008 = 1 THEN 'C28195' END AS thromboembolism
		FROM FV_PatientData	 
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/overview/comorbidity/{RECORD_ID}";
		rr:class fvc:comorbidities;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{ASTHMA}"];
	];	


	rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{ATRIAL_FIBRILLATION}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{CEREBROVASCULAR_ACCIDENT}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{COPD}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{CORONARY_ARTERY_DISEASE}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{DIABETES_MELLITUS}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{DYSLIPIDEMIA}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{HYPERTENSION}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{HYPOTHYROIDISM}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{MALIGNANCY}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{KIDNEY_DISORDER}"];
	];


		rr:predicateObjectMap [
		rr:predicate fvc:comorbidity;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{THROMBOEMBOLISM}"];
	];
.	


