<#induction_other>

	rr:logicalTable[rr:sqlQuery """
		SELECT
			record_id,
			CASE 
				WHEN induction_treatment_atc = 'L04AA06' THEN 'C673' -- mycophenolic acid
				WHEN induction_treatment_atc = 'S01AD05' THEN 'C20493' -- interferon
				WHEN induction_treatment_atc IN ('J06BA02','J06BA01','J06BA','J06B') THEN 'C2701' -- therapeutic immunoglobulins
				WHEN induction_treatment_atc = 'R03DX05' THEN 'C29299' -- omalizumab
				WHEN induction_treatment_atc = 'R03DC03' THEN 'C66189' -- montelukast
				WHEN induction_treatment_atc = 'S01XA18' THEN 'C406' -- cyclosporin
				WHEN induction_treatment_atc = 'R03DX09' THEN 'C157376' -- mepolizumab 
			END AS treatment_encoding
		FROM FV_PatientData	
	"""];


	rr:subjectMap [
		rr:template "http://w3id.org/FAIRVASC/resource/italivas/overview/treatment/induction/{RECORD_ID}_{TREATMENT_ENCODING}";
		rr:class fvc:TreatmentInduction;
	];


	rr:predicateObjectMap [
		rr:predicate fvc:treatmentType;
		rr:objectMap [rr:template "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#{TREATMENT_ENCODING}"];
	]; 
.


