<#clinical_test_complement_c3>

	rr:logicalTable [rr:sqlQuery """
		SELECT
			record_id,
			FORMATDATETIME(PARSEDATETIME(followup_date,'yyyy-mm-dd'),'yyyy-mm-dd')||'T00:00:00' AS date_of_encounter,
			CASE WHEN complement_c3 >= 15.0 THEN complement_c3 / 100.0 ELSE complement_c3 END AS complement_c3_g_l, --convert mg/dl to g/l
			CASE WHEN complement_c3 IS NOT NULL THEN 'C80174' END AS test_type, --Complement C3 Measurement
			CASE WHEN complement_c3 IS NOT NULL THEN 'C42576' END AS test_unit --Kilogram per Cubic Meter = g/L
